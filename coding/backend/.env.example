PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Development storage driver.
# Use memory for local tests/dev, or supabase for persistent storage.
STORAGE_DRIVER=memory

# Supabase settings for persistent storage.
# Keep both keys on the backend. Never expose SUPABASE_SERVICE_ROLE_KEY in frontend code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# AI planner settings.
# Use gemini with GEMINI_API_KEY for real AI, or leave as rule-based for local fallback.
AI_PROVIDER=rule-based
AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=replace-with-gemini-api-key
